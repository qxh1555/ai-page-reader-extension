# AI Provider: "anthropic" | "deepseek" | "openai" | "custom"
# All providers use Anthropic-compatible Messages API format.
# For providers that don't support it natively (e.g., OpenAI),
# set baseURL to a proxy/gateway that translates.
AI_PROVIDER=deepseek

# --- DeepSeek (Anthropic-compatible endpoint) ---
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Anthropic (official) ---
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OpenAI (requires Anthropic-compatible proxy) ---
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://your-proxy.example.com
# OPENAI_MODEL=gpt-4o

# --- Custom / Local model (Ollama, vLLM, etc.) ---
# CUSTOM_API_KEY=ollama
# CUSTOM_BASE_URL=http://localhost:11434
# CUSTOM_MODEL=llama3

PORT=3000
MAX_CONTEXT_LENGTH=30000
